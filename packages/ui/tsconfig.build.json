{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "baseUrl": ".",
    "moduleResolution": "Node16",
    "paths": {
      "@hbdlzy/tokens": ["../tokens/dist/index.d.ts"],
      "@hbdlzy/tokens/*": ["../tokens/dist/*"],
      "@hbdlzy/ui-core": ["../ui-core/dist/index.d.ts"],
      "@hbdlzy/ui-core/*": ["../ui-core/dist/*"],
      "@hbdlzy/ui-energy": ["../ui-energy/dist/index.d.ts"],
      "@hbdlzy/ui-energy/*": ["../ui-energy/dist/*"]
    },
    "declaration": true,
    "emitDeclarationOnly": true,
    "declarationMap": false,
    "outDir": "./dist",
    "rootDir": "./src",
    "composite": false,
    "skipLibCheck": true
  },
  "include": [
    "src/**/*.ts"
  ],
  "exclude": [
    "dist",
    "node_modules"
  ]
}
